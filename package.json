{
  "name": "@jonloucks/concurrency-ts",
  "version": "1.0.1",
  "description": "TypeScript asynchronous concurrency library with Waitables, Completables, and State Machines",
  "private": true,
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./version": {
      "types": "./version.d.ts",
      "import": "./version.js",
      "default": "./version.js"
    },
    "./api/*": {
      "types": "./api/*.d.ts",
      "import": "./api/*.js",
      "default": "./api/*.js"
    },
    "./auxiliary/*": {
      "types": "./auxiliary/*.d.ts",
      "import": "./auxiliary/*.js",
      "default": "./auxiliary/*.js"
    }
  },
  "files": [
    "*",
    "!never-publish/**/*",
    "!**/*.test.*",
    "!**/*.spec.*"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsx --test $(find src -name '*.test.ts')",
    "test:watch": "tsx --test --watch $(find src -name '*.test.ts')",
    "test:coverage": "mkdir -p coverage && tsx --test --experimental-test-coverage --experimental-specifier-resolution=node --test-reporter=lcov $(find src -name '*.test.ts') > coverage/lcov.info",
    "test:coverage-report": "npx badges-ts coverage-report",
    "test:coverage-gate": "npx badges-ts coverage-gate",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "prepublishOnly": "npm run build",
    "before:publish": "npm run clean && npm run compile && cp package.json dist && cp README.md dist && cd dist && npm pkg delete private",
    "after:publish": "npm run clean",
    "prepare": "npm run build",
    "docs": "typedoc --options typedoc.json",
    "badges": "npx badges-ts generate",
    "discover": "npx badges-ts discover",
    "clean": "rm -rf dist",
    "compile": "tsc",
    "postversion": "npm run applyversion",
    "applyversion": "npx badges-ts apply-version",
    "pack-package": "npm run before:publish && mkdir -p packs && cd dist && npm pack && mv *.tgz ../packs/ && npm run after:publish"
  },
  "keywords": [
    "typescript",
    "concurrency",
    "statemachine",
    "asynchronous",
    "waitable",
    "completable",
    "notify"
  ],
  "author": "Jon Loucks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonloucks/concurrency-ts.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "overrides": {
    "minimatch": ">=10.2.4 <11.0.0"
  },
  "devDependencies": {
    "@jonloucks/badges-ts": "^1.4.5",
    "@types/node": "^26.3.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.58.1",
    "eslint": "^10.9.1",
    "tsx": "^4.23.12",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@jonloucks/contracts-ts": "^2.0.5"
  }
}
